#!/bin/bash
set -e

version=$(grep "\"version\"" package.json | cut -d ":" -f 2 | cut -d "\"" -f 2)
arch="$(uname -m)"
app_dir="dist/linux-unpacked"

if [ "$arch" = "aarch64" ]; then
  app_dir="dist/linux-arm64-unpacked"
  # GCC 15 on arm64 can fail compiling @discordjs/opus unless this warning is not treated as an error.
  CFLAGS="-Wno-error=implicit-function-declaration" npm install
else
  npm install
fi
npm run build
npm run pack

chmod +x scripts/snap/*.sh
mkdir -p snap/gui
cp -a scripts/snap/gui/. snap/gui/
cp config/building/snapcraft.yaml snap/snapcraft.yaml
sed -i "s/version:.*/version: ${version}/" snap/snapcraft.yaml
sed -i "s|source: dist/linux-unpacked/|source: ${app_dir}/|" snap/snapcraft.yaml
mkdir -p "$app_dir/resources/app.asar.unpacked/node_modules/@img"
cp -a "node_modules/@img/sharp-libvips-linux-$(node -p 'process.arch')" \
  "$app_dir/resources/app.asar.unpacked/node_modules/@img/"
cp scripts/snap/*.sh "$app_dir"
snapcraft --verbose pack
